<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicit data-extraction rules (Android 12+). Only game progress DataStore is included.
    Explicit <include> limits backup to only the listed paths; other domains are excluded
    implicitly, avoiding auth tokens, caches, and device-specific state.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/worldfood_match_save.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/worldfood_match_save.preferences_pb" />
    </device-transfer>
</data-extraction-rules>