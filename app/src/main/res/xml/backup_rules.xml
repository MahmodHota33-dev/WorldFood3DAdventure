<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicit backup rules. Only game progress DataStore is included.
    All other domains (sharedpref, database, cache, no_backup) are excluded by default
    because explicit <include> elements limit backup to only the listed paths.
-->
<full-backup-content>
    <include domain="file" path="datastore/worldfood_match_save.preferences_pb" />
</full-backup-content>